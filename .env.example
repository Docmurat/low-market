# Скопируйте в .env и заполните
# Локально: PostgreSQL 17 на порту 5433 (на 5432 живёт чужой PG14 — не трогать)
DATABASE_URL="postgresql://postgres:ПАРОЛЬ@localhost:5433/voltshop?schema=public"

# Бренд
NEXT_PUBLIC_SITE_NAME="LOW-Market"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# API поставщика АБСОЛЮТ ТРЕЙД (eCommerce API v3)
# Локально — через nginx-прокси на сервере (IP сервера в белом списке поставщика).
# На проде: SUPPLIER_API_URL="https://api.absoluttrade.ru", SUPPLIER_PROXY_KEY не нужен.
SUPPLIER_API_URL="https://89.169.138.130:8443/supplier"
SUPPLIER_API_TOKEN=""
SUPPLIER_PROXY_KEY=""
# Пауза между запросами к поставщику, мс (лимит ~1 запрос / 3 с)
SUPPLIER_MIN_INTERVAL_MS="3200"
