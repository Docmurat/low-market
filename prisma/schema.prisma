// Схема данных. Шаг 6b: каталог, зеркалирующий дерево поставщика + поля фида.
// Шаг 3: корзина (Cart/CartItem) и заказы (Order/OrderItem).
// Шаг 4: пользователи (User/Session/LoginCode), userId в Cart и Order.
// Шаг 5: role у User (доступ в админку), categoryLocked у Product (ручная категория).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int        @id @default(autoincrement())
  slug      String     @unique
  name      String
  parentId  Int?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  // Наценка категории в процентах. Если null — берётся из матрицы в src/lib/pricing.ts
  // (матрица ищет по цепочке slug: лист → родитель → корень).
  markupPct Decimal?   @db.Decimal(5, 2)
  products  Product[]
  sortOrder Int        @default(0)
  // Категория без товаров в фиде поставщика — прячем с витрины, но не удаляем.
  isActive  Boolean    @default(true)

  // --- связь с деревом поставщика (АБСОЛЮТ ТРЕЙД) ---
  supplierId   Int?    @unique // id узла в CategoryTree — ключ синхронизации
  supplierCode String? // код для ProductSearch (НЕ уникален: CBL, NIC, MAS встречаются дважды)
  supplierPath String? // "Ноутбуки и компьютеры/Ноутбуки/Ноутбуки и аксессуары" — по нему кладём товар
  level        Int     @default(0) // 0 корень, 1, 2 — глубина
  productCount Int     @default(0) // сколько товаров пришло в последнем синке

  @@index([parentId])
  @@index([supplierPath])
}

model Product {
  id          Int      @id @default(autoincrement())
  supplierSku String   @unique // productId (elko-код) поставщика — ключ синхронизации
  slug        String   @unique
  name        String
  brand       String   @default("")
  description String   @default("")
  // basePrice — наша закупочная цена (с НДС, см. pricing.ts). price — розничная после наценки.
  basePrice   Decimal  @db.Decimal(12, 2)
  price       Decimal  @db.Decimal(12, 2)
  // rrp — рекомендованная розничная цена поставщика (может отсутствовать).
  rrp         Decimal? @db.Decimal(12, 2)
  // stock — число для сортировки/фильтров ("> 10" → 10). stockLabel — как прислал поставщик,
  // чтобы на витрине показывать "много" вместо точного числа.
  stock       Int      @default(0)
  stockLabel  String?
  // Остатки по складам как пришли: [{"stock":"MSK","quantity":"> 10"}]
  stocks      Json     @default("[]")
  isActive    Boolean  @default(true)
  // Характеристики: {"Процессор": "AMD Ryzen 7 5700U", "Оперативная память": "16Гб"}
  specs       Json     @default("{}")
  images      String[] @default([])
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  // Категорию поменяли вручную в админке → синк её больше НЕ перезаписывает
  // (по аналогии с защитой description/images).
  categoryLocked Boolean @default(false)

  // --- поля фида поставщика ---
  vendorCode         String?  // код бренда у поставщика (LV, HM, …); brand — имя из справочника Vendors
  manufacturerCode   String?  // партномер производителя (Part Number)
  supplierCategoryCode String? // categoryCode из фида
  eanCodes           String[] @default([])
  warrantyMonths     Int?
  gism               Boolean  @default(false) // Честный ЗНАК — обязательная маркировка
  traceability       Boolean  @default(false) // прослеживаемый товар
  isEol              Boolean  @default(false) // снят с производства → деактивируем
  isNew              Boolean  @default(false)
  supplierUpdatedAt  DateTime? // lastUpdateDate из фида
  syncedAt           DateTime? // когда последний раз обновляли цену/остаток
  specsSyncedAt      DateTime? // когда последний раз тянули Description/MediaItems (null = ещё не тянули)

  attributes  ProductAttribute[]
  cartItems   CartItem[]
  orderItems  OrderItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive, stock])
  @@index([brand])
  @@index([specsSyncedAt])
}

/// Журнал прогонов синхронизации с поставщиком (для админки и алертов).
model SyncLog {
  id          Int       @id @default(autoincrement())
  mode        String    // full | prices | specs
  args        String    @default("") // --category=NB --limit=30 …
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  status      String    @default("running") // running | ok | error
  fetched     Int       @default(0) // товаров получено от поставщика
  created     Int       @default(0)
  updated     Int       @default(0)
  skipped     Int       @default(0)
  deactivated Int       @default(0)
  specsDone   Int       @default(0)
  errors      Int       @default(0) // ошибок по категориям/пачкам (прогон продолжился)
  apiRequests Int       @default(0)
  message     String    @default("") // текст фатальной ошибки или заметки
  log         String    @default("") // хвост консольного вывода (последние ~100 строк)

  @@index([startedAt])
}

/// Нормализованные значения характеристик для фильтров и быстрого поиска.
/// Строится скриптом scripts/build-attributes.ts из Product.specs по конфигу
/// src/lib/filters/config.ts. Сырые specs не трогаем.
model ProductAttribute {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String  // id фильтра из конфига: brand, ram, ssd, gpu_chip …
  value     String  // нормализованное отображаемое значение: "16 ГБ", "LGA1700"
  numValue  Float?  // числовое значение для диапазонов/сортировки (ГБ, МГц, шт.)

  @@unique([productId, key, value])
  @@index([key, value])
  @@index([key, numValue])
}

/// Покупатель. Вход: телефон (SMS-код) и/или email + пароль.
/// phone — нормализован (+7XXXXXXXXXX), уникален; email необязателен, но если есть — уникален.
/// passwordHash: "scrypt:<соль>:<хеш>" (src/lib/auth.ts); null = пароль не задан (вход только по SMS).
/// role: "customer" | "admin" (строка, без enum). admin назначается scripts/make-admin.ts.
model User {
  id           Int       @id @default(autoincrement())
  phone        String    @unique // +7XXXXXXXXXX
  email        String?   @unique
  passwordHash String?
  name         String    @default("")
  role         String    @default("customer")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions Session[]
  carts    Cart[]
  orders   Order[]
}

/// Сессия входа. id (cuid) хранится в httpOnly-cookie lm_session (30 дней).
/// Удаление строки = мгновенный выход на всех устройствах.
model Session {
  id        String   @id @default(cuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Одноразовый код входа по SMS. Живёт 5 минут, максимум 5 попыток ввода,
/// повторная отправка не чаще раза в минуту (проверяем по createdAt последней записи).
/// Код хранится открыто — он короткоживущий и бесполезен после usedAt/expiresAt.
model LoginCode {
  id        Int       @id @default(autoincrement())
  phone     String    // +7XXXXXXXXXX
  code      String    // 6 цифр
  attempts  Int       @default(0)
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([phone, createdAt])
}

/// Корзина. id (cuid) хранится в cookie lm_cart (90 дней).
/// Цены в корзине НЕ фиксируются — всегда берём актуальную Product.price;
/// снимок цены делается только при создании заказа (OrderItem).
/// userId: null = гостевая; при входе гостевая корзина сливается в корзину пользователя.
model Cart {
  id        String     @id @default(cuid())
  userId    Int?
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty       Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([cartId, productId])
  @@index([cartId])
}

/// Заказ покупателя. Создаётся на шаге подтверждения чекаута со статусом new.
/// Оплата (ЮKassa) — шаг 7, заказ у поставщика — шаг 6c.
/// userId: null = гостевой заказ; в ЛК гостевые заказы подтягиваются по номеру телефона.
/// Статусы: new → confirmed → paid → shipped → done | cancelled (строка, без enum —
/// чтобы менять набор без миграций).
model Order {
  id          Int      @id @default(autoincrement())
  number      String   @unique // LM-000123 — человекочитаемый номер
  accessToken String   @unique @default(cuid()) // секретная ссылка на страницу заказа
  status      String   @default("new")

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // контакты
  customerName String
  phone        String   // нормализован: +7XXXXXXXXXX
  email        String   @default("")

  // доставка: courier | pickup. Адрес — структурой (для зон доставки, шаг 8).
  deliveryMethod String
  city           String @default("")
  street         String @default("")
  house          String @default("")
  apartment      String @default("")
  entrance       String @default("")
  floor          String @default("")
  intercom       String @default("")
  comment        String @default("")

  // суммы, ₽ (снимок на момент заказа)
  itemsTotal   Decimal @db.Decimal(12, 2)
  deliveryCost Decimal @db.Decimal(12, 2) @default(0)
  total        Decimal @db.Decimal(12, 2)

  cartId    String? // из какой корзины создан (для отладки)
  items     OrderItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([phone])
  @@index([userId])
}

/// Позиция заказа — снимок товара на момент оформления (цена, название, артикул).
model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  sku       String   // supplierSku
  name      String
  brand     String   @default("")
  image     String   @default("")
  price     Decimal  @db.Decimal(12, 2) // розничная на момент заказа
  basePrice Decimal  @db.Decimal(12, 2) // закупка на момент заказа (для маржи в админке)
  qty       Int

  @@index([orderId])
}
