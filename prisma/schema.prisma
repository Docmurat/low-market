// Схема данных. Шаг 1: каталог. Заказы/пользователи добавим на шагах 3-4.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int        @id @default(autoincrement())
  slug      String     @unique
  name      String
  parentId  Int?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  // Наценка категории в процентах. Если null — берётся из матрицы в src/lib/pricing.ts
  markupPct Decimal?   @db.Decimal(5, 2)
  products  Product[]
  sortOrder Int        @default(0)

  @@index([parentId])
}

model Product {
  id          Int      @id @default(autoincrement())
  supplierSku String   @unique // артикул поставщика — ключ синхронизации
  slug        String   @unique
  name        String
  brand       String   @default("")
  description String   @default("")
  // basePrice — закупочная цена из API поставщика. price — розничная после наценки.
  basePrice   Decimal  @db.Decimal(12, 2)
  price       Decimal  @db.Decimal(12, 2)
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  // Характеристики хранятся как JSON: {"Сокет": "AM5", "Объём памяти": "16 ГБ"}
  specs       Json     @default("{}")
  images      String[] @default([])
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive, stock])
}
